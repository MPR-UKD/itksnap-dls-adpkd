# Environment for docker/compose.yml.
#
# Copy this file to docker/.env and adjust the values:
#   cp docker/.env.example docker/.env
# Compose reads docker/.env automatically when started with -f docker/compose.yml.
# docker/.env is gitignored; keep machine-specific paths there.

# --- Host folders ------------------------------------------------------------
# Relative paths are resolved from the docker/ directory, so ../data is the
# data/ folder in the repository root. Absolute paths work as well.

# Shared data folder, mounted at /data in both containers. The plugin writes
# the images to segment to adpkd/inputs/itksnap/, and adpkd-net writes its
# results to adpkd/outputs/<job_id>/. Holds patient data: keep it out of git
# and out of cloud-synced folders.
DATA_DIR=../data

# Model weights. Two subfolders are used:
#   itksnap/  nnInteractive and SAM2 weights, downloaded on first use
#   adpkd/    contents of the adpkd-net trained_models folder (from Google Drive,
#             see README), i.e. adpkd/nnUNet/... and adpkd/preprocessing/...
MODELS_DIR=../models

# --- Network -----------------------------------------------------------------
# Host port ITK-SNAP connects to (the server listens on 8911 inside the container).
PORT=8911

# --- Performance -------------------------------------------------------------
# Use the single (small) ADPKD model instead of the 2D + 3D ensemble. Faster,
# slightly less accurate; recommended on machines without an NVIDIA GPU.
ADPKD_RUN_SMALL=False

# CPU threads for nnInteractive. Only matters without a GPU; set it close to
# the number of CPU cores.
ITKSNAP_DLS_CPU_THREADS=6

# --- GPU (optional) ----------------------------------------------------------
# The GPU is enabled by adding docker/compose.gpu.yml:
#   docker compose -f docker/compose.yml -f docker/compose.gpu.yml up --build
# To make that the default when running `docker compose up` from inside docker/,
# uncomment the next line (use ":" instead of ";" on Linux and macOS).
# COMPOSE_FILE=compose.yml;compose.gpu.yml
